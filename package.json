{
  "name": "brodex",
  "version": "0.0.1",
  "description": "An autonomous coding agent that runs on the host and drives a persistent Linux sandbox container, operating only on the host directories you explicitly mount.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "bin": {
    "brodex": "./bin/brodex"
  },
  "scripts": {
    "brodex": "bun run src/index.ts",
    "agent": "bun run src/agent/index.ts",
    "tui": "bun run src/tui/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yargs": "17.7.2",
    "zod": "^3.25.76",
    "ink": "5.1.0",
    "react": "18.3.1",
    "ink-text-input": "6.0.0",
    "clipboardy": "4.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/yargs": "17.0.33",
    "@types/react": "18.3.12",
    "typescript": "5.7.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
